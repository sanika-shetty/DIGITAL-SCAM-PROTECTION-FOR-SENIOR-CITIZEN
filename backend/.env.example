# Guardian Bot Backend Configuration

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Firebase Configuration (Optional: system runs in Reactive Demo Mode if unset)
FIREBASE_PROJECT_ID=guardian-bot-senior-safety
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@guardian-bot.iam.gserviceaccount.com
# Use literal newlines or \n escaped private key string:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"

# Or path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Scam Engine Thresholds
ALERT_CRITICAL_THRESHOLD=75
ALERT_HIGH_THRESHOLD=50
ALERT_MEDIUM_THRESHOLD=25
